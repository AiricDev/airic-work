# Copy to .env (gitignored). Relative paths resolve from this file's directory.
# Existing system environment values override this file. No variable interpolation.
AIRIC_HOST=127.0.0.1
AIRIC_PORT=8010
AIRIC_DATA_DIR=.airic-data
# Optional path overrides; otherwise derived from AIRIC_DATA_DIR:
# AIRIC_DATABASE_PATH=.airic-data/db/airic.sqlite
# AIRIC_BLOB_DIRECTORY=.airic-data/blobs
# AIRIC_METHOD_DIRECTORY=.airic-data/methods
# AIRIC_RUNTIME_DIRECTORY=.airic-data/executions
# AIRIC_CREDENTIAL_DIRECTORY=.airic-data/credentials

# Trusted user-info endpoint, with top-level field mapping.
AIRIC_IDENTITY_ISSUER=certlab
AIRIC_IDENTITY_ENDPOINT=https://certlab.example/api/v1/auth/me
AIRIC_IDENTITY_SUBJECT_FIELD=user_id
AIRIC_IDENTITY_NAME_FIELD=username
# AIRIC_IDENTITY_CA_FILE=certs/internal-ca.pem
AIRIC_IDENTITY_TIMEOUT_MS=10000
AIRIC_IDENTITY_MAX_RESPONSE_BYTES=65536
AIRIC_IDENTITY_MAX_TOKEN_BYTES=16384

# One selected OM source; JSON values use single quotes for dotenv.
AIRIC_OM_SOURCES='{"default":{"kind":"local","directory":"../certlab-om"}}'
AIRIC_OM_SOURCE=default
AIRIC_OM_BRANCH=main
AIRIC_OM_ROOT=om.md
AIRIC_GIT_TIMEOUT_MS=30000
AIRIC_OM_MAX_TREE_BYTES=10485760
AIRIC_OM_MAX_FILE_BYTES=10485760
AIRIC_OM_MAX_SNAPSHOT_BYTES=134217728
AIRIC_OM_HISTORY_ENTRIES=50

AIRIC_RUNTIME_VERSION=pi-durable@1.4.0
AIRIC_WORKER_SKILL_VERSION=0.2.0
AIRIC_WORKER_SKILL_PATH=backend/skills/airic-work-worker/SKILL.md
AIRIC_MODEL_PROVIDER=openai
AIRIC_MODEL_ID=gpt-6.1-sol
AIRIC_MODEL_API_KEY=
AIRIC_MODEL_ENV='{}'

# Replace [] with configured HTTPS connections. issuer must match User.issuer.
# [{"id":"certlab","issuer":"certlab","endpoint":"https://certlab.example/mcp","issueEndpoint":"https://certlab.example/api/v1/auth/mcp-token","revokeEndpoint":"https://certlab.example/api/v1/auth/mcp-token/revoke"}]
AIRIC_MCP_CONNECTIONS='[]'
# Required: 32 random bytes encoded as 64 hex characters. Keep stable across restarts.
AIRIC_MCP_ENCRYPTION_KEY=
