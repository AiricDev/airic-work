# Host deployment settings. Use the absolute path of this deployment's data directory.
AIRIC_DEPLOY_DATA=/srv/airic-work/data
# Match the owner of data/. Obtain these with id -u and id -g.
AIRIC_DEPLOY_UID=1000
AIRIC_DEPLOY_GID=1000
# Linux: stat -c %g /var/run/docker.sock. Docker Desktop: 0.
AIRIC_DOCKER_SOCKET_GID=0
# Existing local OM checkout, or an empty directory when using a remote OM URL.
AIRIC_DEPLOY_OM_MOUNT=./om

AIRIC_TASK_WORKER=1
AIRIC_TASK_TOKEN=
AIRIC_TASK_FINGERPRINT_KEY=
AIRIC_TASK_MCP_ALLOWLIST='[]'

AIRIC_OM_REPOSITORY=

AIRIC_MODEL_PROVIDER=openai
AIRIC_MODEL_ID=gpt-6.1-sol
AIRIC_MODEL_API_KEY=
