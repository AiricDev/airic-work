# Copy to airic-work.env. Use service DNS/reachable HTTPS addresses, not container localhost.
AIRIC_IDENTITY_ISSUER=certlab
AIRIC_IDENTITY_ENDPOINT=https://certlab.example/api/v1/auth/me
AIRIC_IDENTITY_SUBJECT_FIELD=actor_id
AIRIC_IDENTITY_NAME_FIELD=display_name
AIRIC_HTTP_SOURCE=certlab
AIRIC_HTTP_ORIGINS='["https://work.example"]'
AIRIC_HTTP_SECURE_COOKIES=true
AIRIC_OM_SOURCES='{"certlab":"https://git.example/team/certlab-om.git"}'
AIRIC_OM_SOURCE=certlab
AIRIC_OM_BRANCH=main
AIRIC_OM_ROOT=om.md
AIRIC_MODEL_PROVIDER=openai
AIRIC_MODEL_ID=gpt-6.1-sol
AIRIC_MODEL_API_KEY=
# Generate once: openssl rand -hex 32. Keep stable and back up separately.
AIRIC_MCP_ENCRYPTION_KEY=
AIRIC_MCP_CONNECTIONS='[]'
# Internal CA: mount the PEM read-only and set BOTH paths before Node starts.
# NODE_EXTRA_CA_CERTS=/etc/airic-work/ca.pem
# AIRIC_IDENTITY_CA_FILE=/etc/airic-work/ca.pem
